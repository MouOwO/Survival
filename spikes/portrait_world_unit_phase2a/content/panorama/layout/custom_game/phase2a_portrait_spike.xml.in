<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/phase2a_portrait_spike.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/phase2a_portrait_data.js" />
        <include src="file://{resources}/scripts/custom_game/phase2a_portrait_spike.js" />
    </scripts>
    <snippets>
        <snippet name="Phase2AStageBase">
            <DOTAScenePanel id="BackgroundSceneSanity" class="BackgroundSceneSanity" map="__BASE_SCENE_MAP__" camera="__BASE_CAMERA_NAME__" light="__BASE_LIGHT_TARGETNAME__" particleonly="__BASE_PARTICLE_ONLY__" hittest="false" />
        </snippet>
        <snippet name="Phase2AStageHead">
            <DOTAScenePanel id="BackgroundSceneSanity" class="BackgroundSceneSanity" map="__HEAD_SCENE_MAP__" camera="__HEAD_CAMERA_NAME__" light="__HEAD_LIGHT_TARGETNAME__" particleonly="__HEAD_PARTICLE_ONLY__" hittest="false" />
        </snippet>
        <snippet name="Phase2AStageHeadWeapon">
            <DOTAScenePanel id="BackgroundSceneSanity" class="BackgroundSceneSanity" map="__HEAD_WEAPON_SCENE_MAP__" camera="__HEAD_WEAPON_CAMERA_NAME__" light="__HEAD_WEAPON_LIGHT_TARGETNAME__" particleonly="__HEAD_WEAPON_PARTICLE_ONLY__" hittest="false" />
        </snippet>
        <snippet name="Phase2AStageAllFive">
            <DOTAScenePanel id="BackgroundSceneSanity" class="BackgroundSceneSanity" map="__ALL_FIVE_SCENE_MAP__" camera="__ALL_FIVE_CAMERA_NAME__" light="__ALL_FIVE_LIGHT_TARGETNAME__" particleonly="__ALL_FIVE_PARTICLE_ONLY__" hittest="false" />
        </snippet>
    </snippets>
    <Panel class="Phase2ARoot" hittest="true">
        <Panel class="Phase2AWindow" hittest="true">
            <Label class="Phase2ATitle" text="Phase 2A · DOTAScenePanel Renderer Sanity Check" />
            <Label class="Phase2ASubtitle" text="同屏隔离 A Direct Unit、B Portrait Background 与 C Prop Background；只测试 Base，不进入 ItemDef 22217。" />
            <Panel class="Phase2ABody">
                <Panel class="Phase2ASceneColumn">
                    <Label id="Phase2AStageLabel" class="Phase2AStageLabel" text="Renderer Sanity · Base only" />
                    <Panel class="RendererSanityRow" hittest="false">
                        <Panel class="RendererSanityCard" hittest="false">
                            <Label class="RendererSanityLabel" text="A. DirectUnitSanity · PASS" />
                            <DOTAScenePanel id="DirectUnitSanity" unit="npc_dota_hero_axe" />
                            <Label class="RendererSanityBinding" text="unit=npc_dota_hero_axe" />
                        </Panel>
                        <Panel class="RendererSanityCard BackgroundCard" hittest="false">
                            <Label class="RendererSanityLabel" text="B. BackgroundSceneSanity · FAIL" />
                            <Panel id="Phase2ASceneHost" class="Phase2ASceneHost" hittest="false" />
                            <Label class="RendererSanityBinding" text="map=phase2a_portrait/axe_base · camera=hero_camera" />
                        </Panel>
                        <Panel class="RendererSanityCard ControlCard" hittest="false">
                            <Label class="RendererSanityLabel" text="C. BackgroundPropControl · 待判定" />
                            <DOTAScenePanel id="BackgroundPropControl" class="BackgroundPropControl" map="__PROP_CONTROL_SCENE_MAP__" camera="__PROP_CONTROL_CAMERA_NAME__" light="__PROP_CONTROL_LIGHT_TARGETNAME__" particleonly="__PROP_CONTROL_PARTICLE_ONLY__" hittest="false" />
                            <Label class="RendererSanityBinding" text="map=phase2a_portrait/axe_prop_control · camera=hero_camera" />
                        </Panel>
                    </Panel>
                    <Label class="RendererSanityDecision" text="A可见/B黑/C可见：map+camera PASS，portrait_world_unit FAIL　·　A可见/B黑/C黑：background scene 加载/packaging FAIL；两种结果都停止" />
                    <Label id="Phase2AStageItems" class="Phase2AStageItems" text="Expected: none" />
                </Panel>
                <Panel class="Phase2AControlColumn">
                    <Label class="Phase2ASectionTitle" text="观察记录" />
                    <Panel class="MetricRow">
                        <Label class="MetricLabel" text="渲染" />
                        <Button id="MetricRendered_unknown" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('rendered', 'unknown')"><Label text="未判定" /></Button>
                        <Button id="MetricRendered_yes" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('rendered', 'yes')"><Label text="可见" /></Button>
                        <Button id="MetricRendered_no" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('rendered', 'no')"><Label text="失败" /></Button>
                    </Panel>
                    <Panel class="MetricRow">
                        <Label class="MetricLabel" text="默认 wearable" />
                        <Button id="MetricDefaultWearable_unknown" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('defaultWearable', 'unknown')"><Label text="未判定" /></Button>
                        <Button id="MetricDefaultWearable_replaced" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('defaultWearable', 'replaced')"><Label text="替换" /></Button>
                        <Button id="MetricDefaultWearable_overlap" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('defaultWearable', 'overlap')"><Label text="重叠" /></Button>
                    </Panel>
                    <Panel class="MetricRow">
                        <Label class="MetricLabel" text="Style 0" />
                        <Button id="MetricStyle0_unknown" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('style0', 'unknown')"><Label text="未判定" /></Button>
                        <Button id="MetricStyle0_correct" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('style0', 'correct')"><Label text="正确" /></Button>
                        <Button id="MetricStyle0_wrong" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('style0', 'wrong')"><Label text="错误" /></Button>
                    </Panel>
                    <Panel class="MetricRow">
                        <Label class="MetricLabel" text="动画" />
                        <Button id="MetricAnimation_unknown" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('animation', 'unknown')"><Label text="未判定" /></Button>
                        <Button id="MetricAnimation_running" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('animation', 'running')"><Label text="运行" /></Button>
                        <Button id="MetricAnimation_frozen" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('animation', 'frozen')"><Label text="冻结" /></Button>
                    </Panel>
                    <Panel class="MetricRow">
                        <Label class="MetricLabel" text="控制台错误" />
                        <Button id="MetricConsoleErrors_unknown" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('consoleErrors', 'unknown')"><Label text="未判定" /></Button>
                        <Button id="MetricConsoleErrors_none" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('consoleErrors', 'none')"><Label text="无" /></Button>
                        <Button id="MetricConsoleErrors_present" class="MetricChoice" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.SetMetric('consoleErrors', 'present')"><Label text="有" /></Button>
                    </Panel>
                    <Label id="Phase2AStatus" class="Phase2AStatus" text="只加载 Base。确认 A/B 已知结果并判定 C；不得加载 ItemDef 22217。" />
                    <Panel class="Phase2AButtons">
                        <Button id="Phase2AReload" class="Phase2AButton Secondary" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.Reload()"><Label text="重载当前阶段" /></Button>
                        <Button id="Phase2AFail" class="Phase2AButton Failure" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.Fail()"><Label text="失败并停止" /></Button>
                        <Button id="Phase2APass" class="Phase2AButton Success" onactivate="GameUI.CustomUIConfig().Phase2APortraitSpike.Pass()"><Label text="通过并停止" /></Button>
                    </Panel>
                    <Label class="Phase2AConsoleHint" text="每次判定写入控制台前缀 [PHASE2A_RESULT]；请同时保存红色错误日志。" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>