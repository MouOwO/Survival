        <MoviePanel id="LotteryCinematicMovie"
                    style="width:1280px;height:720px;horizontal-align:center;vertical-align:center;"
                    src="file://{resources}/videos/custom_game/lottery_cinematic_v1/map.webm"
                    autoplay="onload" hittest="false" hittestchildren="false" />
    </Panel>
</root>
