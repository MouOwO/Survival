<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/common/ui_components.css" />
    <include src="file://{resources}/styles/custom_game/common/ui_typography.css" />
    <include src="file://{resources}/styles/custom_game/remaining_5d5c1152eb.css" />
    <include src="file://{resources}/styles/custom_game/payment_test.css" />
    <include src="file://{resources}/styles/custom_game/commerce_wallet.css" />

  <include src="file://{resources}/styles/custom_game/common/menu_v10.css" /><include src="file://{resources}/styles/custom_game/menus_v10_commerce.css" /><include src="file://{resources}/styles/custom_game/payment_checkout.css" /></styles>
  <scripts><include src="file://{resources}/scripts/custom_game/common/item_resources.js" /><include src="file://{resources}/scripts/custom_game/reward_presentation.js" /><include src="file://{resources}/scripts/custom_game/common/vip_badges.js" /><include src="file://{resources}/scripts/custom_game/common/ui_registry.js" /><include src="file://{resources}/scripts/custom_game/common/ui_components.js" /><include src="file://{resources}/scripts/custom_game/common/tooltip_dismiss.js" /><include src="file://{resources}/scripts/custom_game/ui_layers.js" /><include src="file://{resources}/scripts/custom_game/archive_v10_data.js" /><include src="file://{resources}/scripts/custom_game/common/menu_v10.js" /><include src="file://{resources}/scripts/custom_game/common/commerce_components.js" /><include src="file://{resources}/scripts/custom_game/payment_capability.js" /><include src="file://{resources}/scripts/custom_game/payment_test.js" /><include src="file://{resources}/scripts/custom_game/commerce_wallet.js" /><include src="file://{resources}/scripts/custom_game/commerce_actions.js" /></scripts>
  <Panel class="PaymentRoot" hittest="false" hittestchildren="true">
    <Button id="PaymentEntry" class="PaymentEntry" onactivate="PaymentShop()"><Label text="商品商城" /></Button>
    <Button id="PaymentScrim" class="PaymentScrim" hittest="false" hittestchildren="false" />
    <Panel id="PaymentDialog" class="PaymentDialog CompactCheckout" hittest="false" hittestchildren="false">
      <Button id="PaymentInputShield" class="PaymentInputShield" hittest="false" hittestchildren="false" tabindex="-1" />
      <Panel id="PaymentHeader" class="PaymentHeader">
        <Label id="PaymentHeading" class="PaymentHeading" text="确认购买" />
        <Button id="PaymentClose" class="PaymentClose" onactivate="PaymentToggle()"><Label text="×" /></Button>
      </Panel>
      <Panel class="PaymentBody">
        <Image id="PaymentProductArt" class="PaymentProductArt" scaling="stretch-to-fit-preserve-aspect" hittest="false" />
        <Label id="PaymentTitle" class="PaymentTitle" text="正在加载商品" />
        <Label id="PaymentPrice" class="PaymentPrice" text="" />
        <Label id="PaymentUnitPrice" class="PaymentUnitPrice" text="" />
        <Panel class="PaymentSummary">
          <Panel class="PaymentRewardCopy">
            <Label id="PaymentDescription" class="PaymentDescription" text="请先完成对局登录" />
            <Label id="PaymentValues" class="PaymentValues" text="" />
          </Panel>
        </Panel>
        <Panel class="PaymentQuantity">
          <Label class="PaymentQuantityLabel" text="数量" />
          <Button id="PaymentQuantityMinus" class="PaymentQuantityStep" hittestchildren="false"><Label text="−" /></Button>
          <TextEntry id="PaymentQuantityInput" class="PaymentQuantityValue" text="1" multiline="false" />
          <Button id="PaymentQuantityPlus" class="PaymentQuantityStep" hittestchildren="false"><Label text="+" /></Button>
          <Label id="PaymentQuantityHint" class="PaymentQuantityHint" text="" />
        </Panel>
        <Panel class="PaymentMethods">
          <Button id="PaymentWeChat" class="PaymentMethod" hittestchildren="false" onactivate="PaymentChannel('wechat')"><Label text="微信支付" /></Button>
          <Button id="PaymentAlipay" class="PaymentMethod" hittestchildren="false" onactivate="PaymentChannel('alipay')"><Label text="支付宝" /></Button>
        </Panel>
        <Panel class="PaymentQRStage">
          <Label id="PaymentQRChannel" class="PaymentQRChannel" text="" />
          <Panel class="PaymentQRFrame" hittest="false">
            <Panel id="PaymentQR" class="PaymentQR" hittest="false" />
            <Label id="PaymentQRState" class="PaymentQRState" text="正在获取付款码…" />
          </Panel>
        </Panel>
        <Panel class="PaymentFooter">
          <Button id="PaymentBack" class="PaymentAction" hittestchildren="false" onactivate="PaymentShop()"><Label text="返回商城" /></Button>
          <Button id="PaymentBuy" class="PaymentAction" hittestchildren="false" onactivate="PaymentBuy()"><Label id="PaymentBuyLabel" text="加载中" /></Button>
          <Button id="PaymentRefresh" class="PaymentAction" hittestchildren="false" onactivate="PaymentRefresh()"><Label text="查询付款结果" /></Button>
          <Button id="PaymentCancel" class="PaymentAction" hittestchildren="false" onactivate="PaymentCancel()"><Label text="取消订单" /></Button>
        </Panel>
        <Label id="PaymentConsumptionNotice" class="PaymentConsumptionNotice" text="请适度娱乐，理性消费" hittest="false" />
      </Panel>
      <Button id="PaymentOpen" class="PaymentBrowser" onactivate="PaymentOpen()"><Label id="PaymentOpenLabel" text="浏览器备用付款页" /></Button>
      <Label id="PaymentStatus" class="PaymentStatus" text="付款后自动发放到当前游戏账号。" />
      <Label id="PaymentHint" class="PaymentHint" text="数量可输入或用 + / − 调整" />
      <Panel id="PaymentProducts" class="PaymentProducts" hittest="false" hittestchildren="false" />
      <TextEntry id="PaymentLink" class="PaymentLink" multiline="false" />
    </Panel>
  </Panel>
</root>
