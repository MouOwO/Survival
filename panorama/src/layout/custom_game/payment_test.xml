<root>
  <styles><include src="file://{resources}/styles/custom_game/payment_test.css" /></styles>
  <scripts><include src="file://{resources}/scripts/custom_game/payment_test.js" /></scripts>
  <Panel class="PaymentRoot" hittest="false">
    <Button id="PaymentEntry" class="PaymentEntry" onactivate="PaymentToggle()"><Label text="商品商城" /></Button>
    <Button id="PaymentScrim" class="PaymentScrim" onactivate="PaymentToggle()" />
    <Panel id="PaymentDialog" class="PaymentDialog" hittest="true">
      <Panel class="PaymentHeader">
        <Label class="PaymentHeading" text="商品商城" />
        <Label class="PaymentSubtitle" text="联调商品 · 微信扫码支付 · 永久存档" />
        <Button class="PaymentClose" onactivate="PaymentToggle()"><Label text="×" /></Button>
      </Panel>
      <Panel class="PaymentBody">
        <Panel class="PaymentCatalog"><Label class="PaymentSection" text="精选商品 / 5 项" /><Panel id="PaymentProducts" class="PaymentProducts" /></Panel>
        <Panel class="PaymentCheckout">
          <Label id="PaymentTitle" class="PaymentTitle" text="正在加载商品" />
          <Label id="PaymentDescription" class="PaymentDescription" text="请先完成对局登录" />
          <Label id="PaymentPrice" class="PaymentPrice" text="" />
          <Panel id="PaymentQR" class="PaymentQR" hittest="false" />
          <Label id="PaymentStatus" class="PaymentDescription" text="付款后自动发放到当前游戏账号。" />
          <Button id="PaymentBuy" class="PaymentAction" onactivate="PaymentBuy()"><Label id="PaymentBuyLabel" text="加载中" /></Button>
          <Panel class="PaymentActions">
            <Button id="PaymentRefresh" class="PaymentAction Secondary" onactivate="PaymentRefresh()"><Label text="查询付款结果" /></Button>
            <Button id="PaymentOpen" class="PaymentAction Secondary" onactivate="PaymentOpen()"><Label text="浏览器付款" /></Button>
          </Panel>
          <TextEntry id="PaymentLink" class="PaymentLink" multiline="false" />
          <Label class="PaymentHint" text="请核对商品及金额后付款。支付宝暂未开放。" />
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
