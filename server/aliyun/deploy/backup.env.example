# Copy to /etc/goufayu/backup.env, owned by root mode 0600. No secrets in this sample.
PGSERVICEFILE=/etc/goufayu/pg_service.conf
PGPASSFILE=/etc/goufayu/migrator.pgpass
PG_BIN=/opt/goufayu/releases/current/deploy/pg-bin
BACKUP_SERVICE=goufayu_migrator
BACKUP_ROOT=/var/backups/goufayu
OFFSITE_REQUIRED=1
# Exclude this ECS's public address in addition to detected local interfaces.
OFFSITE_EXCLUDED_HOSTS=47.110.238.248
# Configure ONE independent repository, its password file, and transport credentials.
# RESTIC_REPOSITORY=sftp:backup@INDEPENDENT_HOST:/srv/backups/goufayu
# RESTIC_PASSWORD_FILE=/etc/goufayu/restic-password
# For S3-compatible storage: use the provider's tested endpoint and a restricted bucket identity.
# RESTIC_REPOSITORY=s3:https://S3_ENDPOINT/BUCKET/goufayu
# AWS_SHARED_CREDENTIALS_FILE=/etc/goufayu/restic-s3-credentials
# AWS_PROFILE=goufayu_backup
# AWS_DEFAULT_REGION=REGION
