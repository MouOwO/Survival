*.vmap binary -text
*.vmap_c binary -text
*.vpk binary -text
*.vmat_c binary -text
*.vtex_c binary -text
*.tga binary -text
*.tif binary -text
*.psd binary -text
output/survival_world_v2/survival_world_v2.vmap filter=lfs diff=lfs merge=lfs -text
output/survival_world_v2/before_cloud_integration_v2/survival_world_v2.vmap filter=lfs diff=lfs merge=lfs -text

# Engine-generated assets retain their native formatting.
output/** -whitespace
*.vpcf -whitespace
*.vmdl -whitespace

# Linux deployment entrypoints must remain executable after a Windows checkout.
server/aliyun/**/*.sh text eol=lf
server/aliyun/deploy/pg-bin/* text eol=lf
server/aliyun/deploy/*.service text eol=lf
server/aliyun/deploy/*.timer text eol=lf
