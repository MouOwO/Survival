*.vmap binary -text
*.vmap_c binary -text
*.vpk binary -text
*.vmat_c binary -text
*.vtex_c binary -text
# Texture dependency CRCs include line endings; keep recipes identical across PCs.
*.vtex text eol=lf
*.tga binary -text
*.tif binary -text
*.psd binary -text
output/survival_world_v2/survival_world_v2.vmap filter=lfs diff=lfs merge=lfs -text
output/survival_world_v2/before_cloud_integration_v2/survival_world_v2.vmap filter=lfs diff=lfs merge=lfs -text

# Engine-generated assets retain their native formatting.
output/** -whitespace
*.vpcf -whitespace
*.vmdl -whitespace

# Custom effect manifests hash authored bytes; retain generator line endings.
art/effects/**/*.vpcf text eol=lf
art/effects/**/*.vmat text eol=lf
art/effects/**/manifest.json text eol=lf

# Linux deployment entrypoints must remain executable after a Windows checkout.
server/aliyun/**/*.sh text eol=lf
server/aliyun/deploy/pg-bin/* text eol=lf
server/aliyun/deploy/*.service text eol=lf
server/aliyun/deploy/*.timer text eol=lf

# UI delivery manifests and recovery checkpoints compare exact authored bytes.
design_refs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Recovery snapshots preserve the original files, including their trailing lines.
design_refs/**/checkpoints/** whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
